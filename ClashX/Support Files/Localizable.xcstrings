    "ClashX fail to create ~/.config/clash.meta folder. Please check privileges or manually create folder and restart ClashX." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClashX fail to create ~/.config/clash.meta folder. Please check privileges or manually create folder and restart ClashX."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClashX 无法创建 ~/.config/clash.meta 文件夹。请检查权限或手动创建文件夹后重启 ClashX。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClashX 無法建立 ~/.config/clash.meta 資料夾。請檢查權限或手動建立資料夾後重新啟動 ClashX。"
          }
        }
      }
    },
    "ClashX needs to install/update a helper tool with administrator privileges, otherwise ClashX won't be able to configure system proxy." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
