    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ClashX use location info to detect your current WiFi network SSID name and provide the auto suspend services."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClashX 使用位置信息来检测当前 Wi-Fi 网络的 SSID 名称，以提供自动挂起服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClashX 使用位置資訊來偵測目前 Wi-Fi 網路的 SSID 名稱，以提供自動掛起服務。"
          }
        }
      }
